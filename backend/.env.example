# SOR SENTINEL — Backend Environment Template (.env.example)
# Copy this file to .env and supply actual values for local development.

# Application
APP_NAME="SOR SENTINEL"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=False

# Security
SECRET_KEY="your-secret-key-minimum-32-characters-change-this"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"
DIGIKEEPER_SECRET_KEY="your-256-bit-hex-encryption-key-for-digikeeper"

# Oracle Database 21c XE
ORACLE_USER="sor_sentinel"
ORACLE_PASSWORD="your-oracle-db-password"
ORACLE_DSN="localhost:1521/XEPDB1"
ORACLE_MIN_POOL=2
ORACLE_MAX_POOL=10

# OpenRouter AI
OPENROUTER_API_KEY="sk-or-your-openrouter-key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_TIMEOUT=60

# Google Gemini AI (Cubbis Assistant)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3-flash-preview"
GEMINI_TIMEOUT=45

# Frontend
FRONTEND_ORIGIN="http://localhost:5173"
